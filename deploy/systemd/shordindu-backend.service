[Unit]
Description=Shordindu Django backend (gunicorn WSGI)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/shordindu/current/backend
EnvironmentFile=/opt/shordindu/shared/backend.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/shordindu/shared/venv/current/bin/gunicorn config.wsgi:application \
  --bind 127.0.0.1:8001 --workers 2 --threads 2 --timeout 60 \
  --access-logfile - --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
