# Shordindu production environment.
#
# Lives at /opt/shordindu/shared/backend.env (chmod 600, owned by ubuntu)
# and is read by systemd's EnvironmentFile= as well as by the deploy script.
#
# FORMAT RULES: one KEY=value per line, no quotes, no spaces around `=`, no
# inline comments, no shell metacharacters. The deploy script sources this file
# before running `manage.py`, so a stray `#` or `$` will corrupt the value.
# URL-encode special characters in passwords inside DATABASE_URL.

SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
DEBUG=False
ALLOWED_HOSTS=13.236.66.156,127.0.0.1,localhost

DATABASE_URL=postgres://shordindu:REPLACE_ME@127.0.0.1:5432/shordindu_ecommerce

# Same origin in production (nginx serves the frontend and the API together),
# but Django still checks Origin on unsafe methods, so this must be exact.
CORS_ALLOWED_ORIGINS=http://13.236.66.156
CSRF_TRUSTED_ORIGINS=http://13.236.66.156
CORS_ALLOW_ALL_ORIGINS=False

# MUST be False while the site is served over plain http:// — browsers discard
# Secure cookies on an http origin, which makes login silently fail.
# Flip to True the moment TLS is in place.
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Media storage: Cloudflare R2 (S3-compatible). Set USE_S3=True and fill the
# block below to serve uploads from R2 instead of shared/media/. Values must be
# single-line with no quotes — see the FORMAT RULES above.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
# Public bucket host without scheme, e.g. pub-abc123.r2.dev or cdn.shordindu.com
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_S3_ADDRESSING_STYLE=path
AWS_QUERYSTRING_AUTH=False
AWS_S3_FILE_OVERWRITE=False

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@shordindu.com
