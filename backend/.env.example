# Copy this file to .env and fill in real values for your machine.
# .env itself is gitignored and must never be committed.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (postgres://USER:PASSWORD@HOST:PORT/NAME) ---
DATABASE_URL=postgres://shordindu:shordindu_dev_pw@localhost:5432/shordindu_ecommerce

# --- CORS (Next.js frontend origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=False

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Media storage ---
# USE_S3=False uses local MEDIA_ROOT (fine for dev). Set True + fill the
# AWS_* vars to use S3 or an S3-compatible store (e.g. local MinIO, Cloudinary S3 API).
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# --- Email (console backend prints emails to the runserver/celery log in dev) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@shordindu.com
