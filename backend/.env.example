# Copy this file to .env and fill in real values for your machine.
# .env itself is gitignored and must never be committed.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (postgres://USER:PASSWORD@HOST:PORT/NAME) ---
DATABASE_URL=postgres://shordindu:shordindu_dev_pw@localhost:5432/shordindu_ecommerce

# --- CORS (Next.js frontend origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=False

# --- Auth cookies ---
# AUTH_COOKIE_SECURE defaults to `not DEBUG` if unset (False in dev, True in prod).
# Leave unset locally over plain http://localhost.
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Media storage (Cloudflare R2 / any S3-compatible store) ---
# USE_S3=False keeps uploads on local MEDIA_ROOT (served by Django in dev).
# Set True to send uploads to R2 instead — see README "Media storage".
# Note: `manage.py test` always forces local storage, so tests never write to
# the bucket even with USE_S3=True here.
USE_S3=False
# Cloudflare dashboard -> R2 -> Manage API Tokens -> Create token
# (Object Read & Write). The token's Access Key ID / Secret Access Key go here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 bucket name.
AWS_STORAGE_BUCKET_NAME=
# R2 ignores regions, but boto3 requires one. Leave as "auto".
AWS_S3_REGION_NAME=auto
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com (Account ID is in the R2 dashboard URL).
AWS_S3_ENDPOINT_URL=
# Public host for serving files, WITHOUT scheme. Either the bucket's
# pub-<hash>.r2.dev domain (enable "Public access" on the bucket) or a custom
# domain you attached. Leave empty for private buckets (signed URLs are used).
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_SIGNATURE_VERSION=s3v4
# "path" keeps the bucket in the URL path (what Cloudflare's R2 examples use,
# and what MinIO needs on localhost). "virtual" puts it in the hostname.
AWS_S3_ADDRESSING_STYLE=path
# False for a public bucket. True keeps .url() returning time-limited signed links.
AWS_QUERYSTRING_AUTH=False
# False gives every upload a unique suffix, so a re-upload never clobbers a file
# another row still points at. Set True to reuse names (overwrite).
AWS_S3_FILE_OVERWRITE=False

# --- Email (console backend prints emails to the runserver/celery log in dev) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@shordindu.com
